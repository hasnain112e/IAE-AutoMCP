# MCPValidator3 Environment Configuration
# ==========================================
# Copy this file to .env and fill in your values
# Usage: cp .env.example .env (Linux/Mac) or copy .env.example .env (Windows)

# ===== REQUIRED =====
# OpenAI API key for LLM-based generation and validation
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# ===== OPTIONAL =====

# ----- LLM Configuration -----
# OpenAI model to use for code generation
# Options: gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-3.5-turbo
# Default: gpt-4o (recommended for best quality)
OPENAI_MODEL=gpt-4o

# Google API key for alternative generation (optional)
# Get your key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# ----- Service Ports -----
# Ports for each service (defaults shown)
# Change these if you have port conflicts
BACKEND_PORT=8000
VALIDATOR_PORT=8002
ORCHESTRATOR_PORT=8100
GENERATOR_PORT=8101
UI_CONTROLLER_PORT=8102

# ----- Timeouts (seconds) -----
# HTTP request timeout for inter-agent communication
HTTP_TIMEOUT=30.0

# LLM API call timeout (generation can take time)
LLM_TIMEOUT=120.0

# Validation timeout (includes Ruff, static analysis, etc.)
VALIDATION_TIMEOUT=120.0

# ----- Input Limits -----
# Maximum code size in bytes (1MB default)
# Prevents DoS attacks from extremely large inputs
MAX_CODE_SIZE=1000000

# Maximum lines of code allowed
MAX_LINES=10000

# Maximum number of tools per API specification
MAX_TOOLS=100

# Maximum iterations for code improvement loop
# System will stop after this many attempts even if score < 80
MAX_ITERATIONS=5

# ----- Scoring Configuration -----
# Minimum score (never 0 - enables learning gradient)
# Even worst code gets this score to provide improvement signal
MIN_SCORE=10

# Approval threshold - code must score this or higher to be approved
# Default: 80 (out of 100)
APPROVAL_THRESHOLD=80

# ----- Feature Flags -----
# Enable automatic regeneration timer (experimental)
# If true, system auto-regenerates after timeout
AUTO_REGENERATE=false

# Timeout before auto-regeneration (seconds)
AUTO_REGENERATE_TIMEOUT=10

# Enable MCP runtime validation (spawns subprocess to test server)
# Warning: Slower but more thorough validation
MCP_RUNTIME_VALIDATION=false

# ----- Logging Configuration -----
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format: simple, detailed, json
LOG_FORMAT=detailed

# ----- Development Settings -----
# Enable debug mode (more verbose logging, no caching)
DEBUG=false

# Enable hot reload for agents (auto-restart on code changes)
HOT_RELOAD=false

# ----- Performance Tuning -----
# HTTP connection pool limits
MAX_KEEPALIVE_CONNECTIONS=10
MAX_CONNECTIONS=20

# Telemetry buffer size (number of events to keep in memory)
TELEMETRY_BUFFER_SIZE=200

# Maximum size per telemetry event (bytes)
MAX_EVENT_SIZE=10000

# ----- Security Settings -----
# Enable CORS (for frontend development)
ENABLE_CORS=true

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Enable API key authentication (future feature)
ENABLE_API_AUTH=false

# API key for authenticated requests (if ENABLE_API_AUTH=true)
API_KEY=your-api-key-here

# ----- Database Configuration -----
# Database URL for storing validation history
# DATABASE_URL=sqlite:///./mcpvalidator.db

# MongoDB — used by AI Database Agent and tool collection store
MONGODB_URI=mongodb://localhost:27017
MONGODB_DBNAME=demo

# ----- AI Database Agent -----
# Service that handles natural language → MongoDB query pipeline
AI_AGENT_HOST=127.0.0.1
AI_AGENT_PORT=8010

# ----- Monitoring & Observability (future feature) -----
# Enable Prometheus metrics endpoint
# ENABLE_METRICS=false

# Metrics port
# METRICS_PORT=9090

# Enable distributed tracing
# ENABLE_TRACING=false

# Jaeger endpoint for traces
# JAEGER_ENDPOINT=http://localhost:14268/api/traces

# ===== NOTES =====
# - Lines starting with # are comments
# - Remove # to uncomment and activate a setting
# - Restart all services after changing .env file
# - Never commit .env file to version control (use .env.example instead)
# - For production, use environment variables instead of .env file
